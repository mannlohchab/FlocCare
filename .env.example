# Optional — platform works without these via Pollinations (free).
# On rate limit / errors it falls back to a local ~1000-word writer.
# A key pasted in the create form is used for that run and is not saved.

# Xiaomi MiMo. Pay-as-you-go keys use the default base URL.
# Token Plan keys (tp- / ttp-) need the base URL from the MiMo console.
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.6-flash

# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# POLLINATIONS_MODEL=openai
# FORCE_LOCAL_WRITER=1
# GEN_CONCURRENCY=3
PORT=8787
