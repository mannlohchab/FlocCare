  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "marked": "^18.1.1",
    "nanoid": "^6.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "5.9.3"
  }
}
